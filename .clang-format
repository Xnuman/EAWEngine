---
Language: Cpp
BasedOnStyle: LLVM
Standard: Latest

IndentWidth: 4
ContinuationIndentWidth: 4
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4
IndentAccessModifiers: false
NamespaceIndentation: None

ColumnLimit: 200
PointerAlignment: Left
ReferenceAlignment: Pointer
DerivePointerAlignment: false

BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: false
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: true
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false

AllowShortBlocksOnASingleLine: Never
AllowShortCaseExpressionOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLambdasOnASingleLine: None
AllowShortLoopsOnASingleLine: false

# Includes (AGENTS.md): the file's own header; its target's private headers; the project's
# libraries in one block, innermost layer first; third-party headers; <windows.h> and the other C
# and system headers; the C++ standard library. Each block sorted. Blocks group by Priority and
# order by SortPriority, so the non-project categories sort above the layer range (2-20).
IncludeBlocks: Regroup
SortIncludes: CaseSensitive
IncludeCategories:
  - Regex: '^"[A-Za-z0-9_]+\.hpp"$'
    Priority: 1
    SortPriority: 1
  - Regex: '^"math/'
    Priority: 2
    SortPriority: 2
  - Regex: '^"core/'
    Priority: 2
    SortPriority: 3
  - Regex: '^"vfs/'
    Priority: 2
    SortPriority: 4
  - Regex: '^"formats/'
    Priority: 2
    SortPriority: 5
  - Regex: '^"audio/'
    Priority: 2
    SortPriority: 6
  - Regex: '^"render/'
    Priority: 2
    SortPriority: 7
  - Regex: '^"assets/'
    Priority: 2
    SortPriority: 8
  - Regex: '^"localization/'
    Priority: 2
    SortPriority: 9
  - Regex: '^"simulation/'
    Priority: 2
    SortPriority: 10
  - Regex: '^"script/'
    Priority: 2
    SortPriority: 11
  - Regex: '^"platform/'
    Priority: 2
    SortPriority: 12
  - Regex: '^"battle/'
    Priority: 2
    SortPriority: 13
  - Regex: '^"presentation/'
    Priority: 2
    SortPriority: 14
  - Regex: '^"scene/'
    Priority: 2
    SortPriority: 15
  - Regex: '^"control/'
    Priority: 2
    SortPriority: 16
  - Regex: '^"sandbox/'
    Priority: 2
    SortPriority: 17
  - Regex: '^"launcher/'
    Priority: 2
    SortPriority: 18
  - Regex: '^"imgui_app/'
    Priority: 2
    SortPriority: 19
  - Regex: '^"(engine_app|tools_gui|asset_inspector|dat_editor|dev_launcher)/'
    Priority: 2
    SortPriority: 20
  - Regex: '^"'
    Priority: 3
    SortPriority: 30
  - Regex: '^<windows\.h>$'
    Priority: 4
    SortPriority: 40
  - Regex: '^<.*\.h>$'
    Priority: 4
    SortPriority: 41
  - Regex: '^<'
    Priority: 6
    SortPriority: 50
SortUsingDeclarations: Lexicographic
SpaceBeforeParens: ControlStatements
SpaceBeforeCpp11BracedList: false
SpacesInAngles: Never
SpacesInParentheses: false
SpacesInSquareBrackets: false
...
